# Frontend Environment Variables (must be prefixed with VITE_)

# GraphQL API endpoint
VITE_OSWATCHER_API_URI=http://localhost:4000

# Auth0 Configuration
# Get these values from your Auth0 dashboard (https://manage.auth0.com/)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_client_id_here
VITE_AUTH0_AUDIENCE=https://your-api.example.com
